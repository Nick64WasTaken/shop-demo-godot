config_version=5

[application]

config/name="shop-demo"
run/main_scene="uid://cm3pqedpv5ifk"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerManager="*uid://cvgsty2veug7s"
ControlsManager="*uid://djbpqr2armthi"
ItemManager="*uid://cqmihaqfpur0e"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="shop-demo"

[filesystem]

import/blender/enabled=false

[global_group]

player=""
ItemManager="Holds ItemManager (DO NOT ADD MORE THAN ONE OBJECT TO THIS GROUP)"
